{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned sanitized local replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "commands", "sanitizer_version", "streaming", "cache_disabled", "body_logging_disabled", "redacted_errors", "stderr", "fields", "removed_fields", "transformations", "field_categories", "source_id", "time_window", "destination", "max_records", "expected_records", "max_bytes", "timeout_seconds", "retention_deadline", "milestone_id", "scenario_id", "plan_revision", "plan_digest"],
  "properties": {
    "milestone_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string", "pattern": "^TESTCASE-[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"type": "string", "minLength": 1},
    "commands": {
      "type": "object", "additionalProperties": false,
      "required": ["acquisition", "sanitizer", "cleanup"],
      "properties": {
        "acquisition": {"$ref": "#/$defs/command"},
        "sanitizer": {"$ref": "#/$defs/command"},
        "cleanup": {"$ref": "#/$defs/command"}
      }
    },
    "sanitizer_version": {"type": "string", "minLength": 1},
    "streaming": {"const": true},
    "cache_disabled": {"const": true},
    "body_logging_disabled": {"const": true},
    "redacted_errors": {"const": true},
    "stderr": {"const": "discard"},
    "fields": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/field"}},
    "removed_fields": {"$ref": "#/$defs/names"},
    "transformations": {"$ref": "#/$defs/names"},
    "field_categories": {"$ref": "#/$defs/names"},
    "source_id": {"type": "string", "minLength": 1},
    "time_window": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
    "destination": {"type": "string", "minLength": 1},
    "max_records": {"type": "integer", "minimum": 1, "maximum": 100000},
    "expected_records": {"type": "integer", "minimum": 1, "maximum": 100000},
    "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "retention_deadline": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "command": {
      "type": "object", "additionalProperties": false, "required": ["argv", "digest"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "field": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["enum"], "properties": {"enum": {"$ref": "#/$defs/names"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "minimum", "maximum"], "properties": {"type": {"const": "integer"}, "minimum": {"type": "integer"}, "maximum": {"type": "integer"}}},
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "boolean"}}}
      ]
    }
  }
}
